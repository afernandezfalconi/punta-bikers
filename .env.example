# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed by the payment webhook and /api/setup. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Your integrations > Webhooks)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Resend (emails)
RESEND_API_KEY=

# Public base URL, used for payment callbacks and webhook notification_url
NEXT_PUBLIC_APP_URL=https://punta-bikers.vercel.app

# Comma-separated emails that get admin rights (alternative: set app_metadata.role=admin in Supabase)
ADMIN_EMAILS=

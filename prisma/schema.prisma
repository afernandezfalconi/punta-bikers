// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  RECEPTIONIST
  ADMIN
}

enum RentalStatus {
  PENDING_DOC
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  INE
  PASSPORT
}

enum ScooterStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum DamageStatus {
  REPORTED
  ASSESSED
  REPAIRED
  CLOSED
}

enum DepositStatus {
  PENDING
  CHARGED
  REFUNDED
  PARTIAL_REFUND
}

enum CommissionStatus {
  PENDING
  PAID
  WITHHELD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique @db.VarChar(255)
  password_hash         String    @db.VarChar(255)
  role                  UserRole  @default(CUSTOMER)
  first_name            String    @db.VarChar(100)
  last_name             String    @db.VarChar(100)
  phone                 String?   @db.VarChar(20)
  hotel_or_business_name String?  @db.VarChar(255)
  is_mexican            Boolean   @default(true)

  // Relations
  customer_rentals      Rental[]  @relation("customer_rentals")
  receptionist_rentals  Rental[]  @relation("receptionist_rentals")
  document_approvals    Document[] @relation("approved_by")
  damage_reports        Damage[]  @relation("reported_by")
  commissions           Commission[]
  payments              Payment[]

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model Rental {
  id                    String    @id @default(cuid())
  scooter_id            String
  customer_id           String
  receptionist_id       String?
  rental_start_date     DateTime
  rental_end_date       DateTime?
  price_per_day         Decimal   @db.Decimal(10, 2)
  total_days            Int
  subtotal              Decimal   @db.Decimal(10, 2)
  deposit_amount        Decimal   @db.Decimal(10, 2)
  commission_amount     Decimal   @db.Decimal(10, 2)
  rental_status         RentalStatus @default(PENDING_DOC)
  cancellation_date     DateTime?
  cancellation_penalty  Decimal?  @db.Decimal(10, 2)
  is_mexican            Boolean

  // Relations
  scooter               Scooter   @relation(fields: [scooter_id], references: [id])
  customer              User      @relation("customer_rentals", fields: [customer_id], references: [id])
  receptionist          User?     @relation("receptionist_rentals", fields: [receptionist_id], references: [id])
  document              Document?
  damages               Damage[]
  deposit               Deposit?
  commission            Commission?
  payment               Payment?

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([scooter_id])
  @@index([customer_id])
  @@index([receptionist_id])
  @@index([rental_status])
}

model Document {
  id                    String    @id @default(cuid())
  rental_id             String    @unique
  document_type         DocumentType
  front_photo_url       String    @db.Text
  back_photo_url        String    @db.Text
  status                DocumentStatus @default(PENDING)
  rejection_reason      String?   @db.Text
  approved_by_user_id   String?

  // Relations
  rental                Rental    @relation(fields: [rental_id], references: [id], onDelete: Cascade)
  approved_by           User?     @relation("approved_by", fields: [approved_by_user_id], references: [id])

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([rental_id])
  @@index([status])
}

model Scooter {
  id                    String    @id @default(cuid())
  model_name            String    @db.VarChar(100)
  license_plate         String    @unique @db.VarChar(20)
  status                ScooterStatus @default(AVAILABLE)
  current_km            Int       @default(0)
  last_maintenance_date DateTime?
  next_maintenance_date DateTime?

  // Relations
  rentals               Rental[]

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([status])
  @@index([license_plate])
}

model Damage {
  id                    String    @id @default(cuid())
  rental_id             String
  reported_by_user_id   String
  report_date           DateTime  @default(now())
  description           String    @db.Text
  video_url             String    @db.Text
  status                DamageStatus @default(REPORTED)
  repair_cost_estimate  Decimal?  @db.Decimal(10, 2)
  repair_cost_actual    Decimal?  @db.Decimal(10, 2)
  charged_from_deposit  Boolean   @default(false)
  notes                 String?   @db.Text

  // Relations
  rental                Rental    @relation(fields: [rental_id], references: [id], onDelete: Cascade)
  reported_by           User      @relation("reported_by", fields: [reported_by_user_id], references: [id])

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([rental_id])
  @@index([status])
}

model Deposit {
  id                    String    @id @default(cuid())
  rental_id             String    @unique
  amount                Decimal   @db.Decimal(10, 2)
  status                DepositStatus @default(PENDING)
  charged_date          DateTime?
  refund_date           DateTime?
  refund_amount         Decimal?  @db.Decimal(10, 2)
  stripe_charge_id      String?   @db.VarChar(255)

  // Relations
  rental                Rental    @relation(fields: [rental_id], references: [id], onDelete: Cascade)

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([rental_id])
  @@index([status])
}

model Commission {
  id                    String    @id @default(cuid())
  rental_id             String    @unique
  receptionist_id       String
  amount                Decimal   @db.Decimal(10, 2)
  status                CommissionStatus @default(PENDING)
  payment_date          DateTime?
  payment_method        String?   @db.VarChar(100)

  // Relations
  rental                Rental    @relation(fields: [rental_id], references: [id], onDelete: Cascade)
  receptionist          User      @relation(fields: [receptionist_id], references: [id])

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([receptionist_id])
  @@index([status])
}

model Payment {
  id                    String    @id @default(cuid())
  rental_id             String    @unique
  customer_id           String
  amount                Decimal   @db.Decimal(10, 2)
  stripe_intent_id      String?   @db.VarChar(255)
  stripe_charge_id      String?   @db.VarChar(255)
  status                PaymentStatus @default(PENDING)

  // Relations
  rental                Rental    @relation(fields: [rental_id], references: [id], onDelete: Cascade)
  customer              User      @relation(fields: [customer_id], references: [id])

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([customer_id])
  @@index([status])
  @@index([stripe_charge_id])
}

model Season {
  id                    String    @id @default(cuid())
  name                  String    @db.VarChar(100)
  price_per_day         Decimal   @db.Decimal(10, 2)
  start_date            DateTime
  end_date              DateTime
  is_active             Boolean   @default(true)

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([is_active])
}
